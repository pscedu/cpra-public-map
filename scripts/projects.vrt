<OGRVRTDataSource>
    <OGRVRTLayer name="metadata">
        <SrcDataSource>data/MP23 Project Metadata and Costs_20220406.xlsx</SrcDataSource>
        <SrcLayer>ProjectMetadata</SrcLayer>
    </OGRVRTLayer>
    <OGRVRTLayer name="projects">
        <SrcDataSource>working/projects.gpkg</SrcDataSource>
        <SrcSQL dialect="sqlite">
            select DisplayID as display_id, 
                ProjectName as name,
                max(ProjectTypeCode) as type,
                max(Region) as region,
                st_minx(st_collect(geom)) as xmin,
                st_miny(st_collect(geom)) as ymin,
                st_maxx(st_collect(geom)) as xmax,
                st_maxy(st_collect(geom)) as ymax
            from (
                select DisplayID,
                    ProjectName,
                    ProjectTypeCode,
                    Region,
                    Shape as geom
                from Points
                where ActiveProject = 1
                union select DisplayID,
                    ProjectName,
                    ProjectTypeCode,
                    Region,
                    Shape as geom
                from Lines
                where ActiveProject = 1
                union select DisplayID,
                    ProjectName,
                    ProjectTypeCode,
                    Region,
                    Shape as geom
                from Polygons
                where ActiveProject = 1
            )
            group by DisplayID, ProjectName
        </SrcSQL>
    </OGRVRTLayer>
</OGRVRTDataSource>